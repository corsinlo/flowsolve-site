---
import LandingPage from '../../components/landing/LandingPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, resolveCopy, type Locale } from '../../i18n';
import { getPublicLinks } from '../../lib/urls';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const copy = resolveCopy(locale);
const links = getPublicLinks(import.meta.env);
---

<BaseLayout {locale} {copy}>
  <LandingPage {locale} {copy} {links} />
</BaseLayout>
